# Google OAuth (Desktop app client). Only needed for `npx gmail-docs-mcp auth`:
# the client ID/secret are copied into the token file, so the server itself
# only needs GOOGLE_TOKEN_PATH. Setting them here overrides the stored values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_PATH=~/.config/gmail-docs-mcp/token.json
# Alternative for platforms without secret files (e.g. Railway): the token
# file's contents as raw or base64 JSON. Takes precedence over GOOGLE_TOKEN_PATH.
# Create with: base64 -i ~/.config/gmail-docs-mcp/token.json | tr -d '\n'
GOOGLE_TOKEN_JSON=

# Transport
MCP_TRANSPORT=stdio              # stdio | http
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3333               # falls back to PORT (set by Railway), then 3333
MCP_HTTP_BEARER_TOKEN=           # required when host is not loopback
MCP_HTTP_ALLOWED_ORIGINS=        # comma-separated, e.g. https://app.example.com
MCP_HTTP_ALLOWED_HOSTS=          # extra Host headers to accept, e.g. my-tunnel.trycloudflare.com

# Email guardrails
EMAIL_DRY_RUN=false
EMAIL_ALLOWED_DOMAINS=           # e.g. example.com,partner.com (empty = any; .example.com = subdomains)
EMAIL_MAX_RECIPIENTS=20
EMAIL_MAX_PER_HOUR=30
GMAIL_SEND_AS=                   # optional verified send-as alias

# Docs guardrails
DOCS_ALLOWED_IDS=                # optional comma-separated doc IDs
DOCS_MAX_APPEND_CHARS=50000
DOCS_MAX_TABLE_ROWS=100
DOCS_MAX_TABLE_COLS=20

# Optional features
ENABLE_DRAFTS=false              # adds restricted gmail.compose scope (re-run auth after changing)

LOG_LEVEL=info                   # debug | info | warn | error
AUDIT_LOG_PATH=                  # optional JSONL file (default: audit lines on stderr)
GOOGLE_TIMEOUT_MS=20000          # timeout for each Google API call
