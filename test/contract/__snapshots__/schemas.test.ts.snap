      "readOnlyHint": false,
      "title": "Send email",
    },
    "description": "Send an email from the connected Gmail account. This sends immediately and cannot be undone. If the user has not clearly stated the recipients and content, confirm with them first. Set dry_run to true to preview without sending.",
    "execution": undefined,
    "icons": undefined,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "bcc": {
          "description": "Optional BCC addresses.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "body": {
          "description": "Email body. Plain text unless body_format is 'html'.",
          "type": "string",
        },
        "body_format": {
          "description": "Format of body. Default 'text'.",
          "enum": [
            "text",
            "html",
          ],
          "type": "string",
        },
        "cc": {
          "description": "Optional CC addresses.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "client_request_id": {
          "description": "Optional unique ID for this request (max 128 characters). If the same ID is sent again within 24 hours, the original result is returned instead of repeating the action.",
          "maxLength": 128,
          "type": "string",
        },
        "dry_run": {
          "description": "If true, validate and return the composed email without sending. Default false.",
          "type": "boolean",
        },
        "subject": {
          "description": "Subject line, plain text, max 250 characters.",
          "type": "string",
        },
        "to": {
          "description": "Recipient email addresses, e.g. ["alex@example.com"]. At least one.",
          "items": {
            "type": "string",
          },
          "minItems": 1,
          "type": "array",
        },
      },
      "required": [
        "to",
        "subject",
        "body",
      ],
      "type": "object",
    },
    "name": "gmail_send_email",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "bcc_count": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
        "cc": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "message_id": {
          "type": "string",
        },
        "status": {
          "enum": [
            "sent",
            "dry_run",
          ],
          "type": "string",
        },
        "subject": {
          "type": "string",
        },
        "thread_id": {
          "type": "string",
        },
        "to": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
      },
      "required": [
        "status",
        "message_id",
        "thread_id",
        "to",
        "cc",
        "bcc_count",
        "subject",
      ],
      "type": "object",
    },
    "title": "Send email",
  },
  {
